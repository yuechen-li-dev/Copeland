{
  "schemaVersion": 1,
  "steps": [
    { "kind": "capture", "path": "00-title.png" },
    { "kind": "click-action", "text": "start" },
    { "kind": "command", "command": "assert screen playing" },
    { "kind": "command", "command": "autopilot on" },
    { "kind": "wait", "seconds": 0.8 },
    { "kind": "capture", "path": "01-start.png" },
    { "kind": "wait", "seconds": 1.6 },
    { "kind": "capture", "path": "02-stairs.png" },
    { "kind": "wait", "seconds": 1.2 },
    { "kind": "capture", "path": "03-gap.png" },
    { "kind": "wait", "seconds": 3.0 },
    { "kind": "capture", "path": "04-shuttle.png" },
    { "kind": "wait", "seconds": 4.5 },
    { "kind": "command", "command": "assert checkpoint 1" },
    { "kind": "capture", "path": "05-isle-c.png" },
    { "kind": "wait", "seconds": 2.0 },
    { "kind": "capture", "path": "06-lift.png" },
    { "kind": "wait", "seconds": 4.0 },
    { "kind": "capture", "path": "07-crumble.png" },
    { "kind": "wait", "seconds": 4.0 },
    { "kind": "command", "command": "assert checkpoint 2" },
    { "kind": "capture", "path": "08-isle-e.png" },
    { "kind": "wait", "seconds": 3.0 },
    { "kind": "capture", "path": "09-turntable.png" },
    { "kind": "wait", "seconds": 7.0 },
    { "kind": "capture", "path": "10-turntable-tip.png" },
    { "kind": "wait", "seconds": 1.6 },
    { "kind": "capture", "path": "11-thorns.png" },
    { "kind": "wait", "seconds": 2.0 },
    { "kind": "command", "command": "assert finished true" },
    { "kind": "command", "command": "assert falls 0" },
    { "kind": "capture", "path": "12-clear.png" },
    { "kind": "tap", "keys": ["Escape"], "seconds": 0 },
    { "kind": "command", "command": "assert screen pause" },
    { "kind": "capture", "path": "13-pause.png" }
  ]
}
