    {
      "kind": "wait",
      "seconds": 2.0
    },
    {
      "kind": "wait",
      "seconds": 4.0
    },
    {
      "kind": "wait",
      "seconds": 4.0
    },
    {
      "kind": "command",
      "command": "assert checkpoint 2"
