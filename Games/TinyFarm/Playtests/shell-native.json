{
  "schemaVersion": 1,
  "steps": [
    {"kind": "capture", "path": "00-title.png"},
    {"kind": "click-action", "text": "start"},
    {"kind": "wait", "seconds": 0.5},
    {"kind": "capture", "path": "01-garden.png"},
    {"kind": "hold", "keys": ["D"], "seconds": 1.2},
    {"kind": "capture", "path": "02-walked.png"},
    {"kind": "tap", "keys": ["I"], "seconds": 0},
    {"kind": "wait", "seconds": 0.2},
    {"kind": "command", "command": "assert tinyfarm.screen inventory"},
    {"kind": "click-action", "text": "equipment"},
    {"kind": "wait", "seconds": 0.05},
    {"kind": "click-action", "text": "search"},
    {"kind": "wait", "seconds": 0.05},
    {"kind": "command", "command": "assert tinyfarm.search-focused true"},
    {"kind": "text", "text": "sword"},
    {"kind": "wait", "seconds": 0.05},
    {"kind": "command", "command": "assert tinyfarm.search sword"},
    {"kind": "tap", "keys": ["Enter"], "seconds": 0},
    {"kind": "wait", "seconds": 0.05},
    {"kind": "command", "command": "assert tinyfarm.search-focused false"},
    {"kind": "capture", "path": "03b-pockets-search.png"},
    {"kind": "click-action", "text": "close"},
    {"kind": "wait", "seconds": 0.05},
    {"kind": "command", "command": "assert tinyfarm.screen playing"},
    {"kind": "command", "command": "assert tinyfarm.hotbar 1"},
    {"kind": "scroll", "x": 0.5, "y": 0.5, "text": "-1"},
    {"kind": "wait", "seconds": 0.05},
    {"kind": "command", "command": "assert tinyfarm.hotbar 2"},
    {"kind": "scroll", "x": 0.5, "y": 0.5, "text": "1"},
    {"kind": "wait", "seconds": 0.05},
    {"kind": "tap", "keys": ["I"], "seconds": 0},
    {"kind": "wait", "seconds": 0.1},
    {"kind": "capture", "path": "03-pockets.png"},
    {"kind": "tap", "keys": ["Escape"], "seconds": 0},
    {"kind": "wait", "seconds": 0.1},
    {"kind": "tap", "keys": ["Escape"], "seconds": 0},
    {"kind": "wait", "seconds": 0.1},
    {"kind": "command", "command": "assert screen pause"},
    {"kind": "capture", "path": "04-pause.png"}
  ]
}
