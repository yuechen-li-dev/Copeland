{
  "schemaVersion": 1,
  "steps": [
    {"kind": "click-action", "text": "start"},
    {"kind": "command", "command": "walk burrow"},
    {"kind": "wait", "seconds": 0.2},
    {"kind": "command", "command": "walk mara"},
    {"kind": "wait", "seconds": 0.2},
    {"kind": "capture", "path": "10-supper-request.png"},
    {"kind": "command", "command": "walk finish"},
    {"kind": "wait", "seconds": 0.2},
    {"kind": "capture", "path": "11-journal.png"},
    {"kind": "command", "command": "walk riverside"},
    {"kind": "wait", "seconds": 0.3},
    {"kind": "capture", "path": "12-riverside.png"},
    {"kind": "command", "command": "walk gather"},
    {"kind": "command", "command": "walk cook"},
    {"kind": "wait", "seconds": 0.2},
    {"kind": "tap", "keys": ["I"], "seconds": 0},
    {"kind": "wait", "seconds": 0.1},
    {"kind": "capture", "path": "13-pockets-supper.png"},
    {"kind": "tap", "keys": ["Escape"], "seconds": 0},
    {"kind": "wait", "seconds": 0.1},
    {"kind": "command", "command": "walk mara"},
    {"kind": "wait", "seconds": 0.2},
    {"kind": "click", "x": 0.5, "y": 0.5},
    {"kind": "wait", "seconds": 0.2},
    {"kind": "capture", "path": "14-give-mint.png"},
    {"kind": "tap", "keys": ["Enter"], "seconds": 0},
    {"kind": "wait", "seconds": 0.2},
    {"kind": "capture", "path": "15-supper-thanks.png"},
    {"kind": "command", "command": "walk finish"},
    {"kind": "wait", "seconds": 0.2},
    {"kind": "command", "command": "assert tinyfarm.supper complete"},
    {"kind": "capture", "path": "16-after-supper.png"}
  ]
}
