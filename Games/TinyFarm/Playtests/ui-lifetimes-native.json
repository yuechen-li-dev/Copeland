{
  "schemaVersion": 1,
  "steps": [
    {"kind": "click-action", "text": "start"},
    {"kind": "wait", "seconds": 0.05},
    {"kind": "tap", "keys": ["I"], "seconds": 0},
    {"kind": "wait", "seconds": 0.05},
    {"kind": "click-action", "text": "search"},
    {"kind": "wait", "seconds": 0.05},
    {"kind": "text", "text": "sword"},
    {"kind": "wait", "seconds": 0.05},
    {"kind": "command", "command": "assert tinyfarm.search sword"},
    {"kind": "capture", "path": "00-search.png"},
    {"kind": "click-action", "text": "close"},
    {"kind": "wait", "seconds": 0.05},
    {"kind": "command", "command": "assert tinyfarm.screen playing"},
    {"kind": "tap", "keys": ["I"], "seconds": 0},
    {"kind": "wait", "seconds": 0.05},
    {"kind": "command", "command": "assert tinyfarm.search-focused false"},
    {"kind": "capture", "path": "01-fresh-inventory.png"},
    {"kind": "click-action", "text": "close"},
    {"kind": "wait", "seconds": 0.05},
    {"kind": "tap", "keys": ["C"], "seconds": 0},
    {"kind": "wait", "seconds": 0.05},
    {"kind": "command", "command": "assert tinyfarm.screen stats"},
    {"kind": "click-action", "text": "close"},
    {"kind": "wait", "seconds": 0.05},
    {"kind": "tap", "keys": ["F10"], "seconds": 0},
    {"kind": "wait", "seconds": 0.05},
    {"kind": "command", "command": "assert tinyfarm.inspector-visible true"},
    {"kind": "capture", "path": "02-live-inspector.png"},
    {"kind": "tap", "keys": ["F10"], "seconds": 0},
    {"kind": "wait", "seconds": 0.05},
    {"kind": "command", "command": "assert tinyfarm.inspector-visible false"},
    {"kind": "command", "command": "walk mara"},
    {"kind": "command", "command": "assert tinyfarm.dialogue true"},
    {"kind": "capture", "path": "03-dialogue.png"},
    {"kind": "command", "command": "walk finish"},
    {"kind": "command", "command": "assert tinyfarm.dialogue false"}
  ]
}
