{
  "schemaVersion": 1,
  "steps": [
    { "kind": "click-action", "text": "start" },
    { "kind": "tap", "keys": ["F9"], "seconds": 0 },
    { "kind": "command", "command": "walk burrow" },
    { "kind": "command", "command": "walk mara" },
    { "kind": "command", "command": "walk finish" },
    { "kind": "command", "command": "walk riverside" },
    { "kind": "wait", "seconds": 0.2 },
    { "kind": "command", "command": "assert tinyfarm.wading false" },
    { "kind": "capture", "path": "00-dry-bank.png" },
    { "kind": "hold", "keys": ["S"], "seconds": 0.65 },
    { "kind": "hold", "keys": ["D"], "seconds": 3.0 },
    { "kind": "capture", "path": "01-in-river.png" },
    { "kind": "command", "command": "assert tinyfarm.wading true" },
    { "kind": "command", "command": "assert tinyfarm.water-disturbed true" },
    { "kind": "tap", "keys": ["J"], "seconds": 0.15 },
    { "kind": "hold", "keys": ["S"], "seconds": 0.4 },
    { "kind": "capture", "path": "02-live-ripples.png" }
  ]
}
