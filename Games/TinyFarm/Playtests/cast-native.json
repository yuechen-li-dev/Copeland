{
  "schemaVersion": 1,
  "steps": [
    { "kind": "click-action", "text": "start" },
    { "kind": "wait", "seconds": 0.2 },
    { "kind": "tap", "keys": ["C"], "seconds": 0 },
    { "kind": "wait", "seconds": 0.1 },
    { "kind": "command", "command": "assert tinyfarm.stats-agent player" },
    { "kind": "command", "command": "assert tinyfarm.portrait-actor player" },
    { "kind": "capture", "path": "00-gardener.png" },
    { "kind": "click-action", "text": "agent:next" },
    { "kind": "wait", "seconds": 0.1 },
    { "kind": "command", "command": "assert tinyfarm.stats-agent elias" },
    { "kind": "command", "command": "assert tinyfarm.portrait-actor elias" },
    { "kind": "capture", "path": "01-elias.png" },
    { "kind": "click-action", "text": "agent:next" },
    { "kind": "wait", "seconds": 0.1 },
    { "kind": "command", "command": "assert tinyfarm.stats-agent mara" },
    { "kind": "capture", "path": "02-mara.png" },
    { "kind": "click-action", "text": "agent:next" },
    { "kind": "wait", "seconds": 0.1 },
    { "kind": "command", "command": "assert tinyfarm.stats-agent sela" },
    { "kind": "command", "command": "assert tinyfarm.portrait-actor sela" },
    { "kind": "capture", "path": "03-sela.png" },
    { "kind": "click-action", "text": "agent:next" },
    { "kind": "wait", "seconds": 0.1 },
    { "kind": "command", "command": "assert tinyfarm.stats-agent shipping-chest" },
    { "kind": "command", "command": "assert tinyfarm.portrait-actor none" },
    { "kind": "capture", "path": "04-object-no-face.png" },
    { "kind": "click-action", "text": "close" },
    { "kind": "wait", "seconds": 0.1 },
    { "kind": "command", "command": "walk burrow" },
    { "kind": "command", "command": "walk mara" },
    { "kind": "command", "command": "assert tinyfarm.dialogue true" },
    { "kind": "command", "command": "assert tinyfarm.portrait-actor mara" },
    { "kind": "capture", "path": "05-mara-dialogue.png" },
    { "kind": "command", "command": "walk finish" },
    { "kind": "command", "command": "walk riverside" },
    { "kind": "wait", "seconds": 0.2 },
    { "kind": "capture", "path": "06-riverside-elias.png" }
  ]
}
