{
  "schemaVersion": 1,
  "steps": [
    {"kind": "click-action", "text": "start"},
    {"kind": "command", "command": "assert tinyfarm.supper not-started"},
    {"kind": "command", "command": "walk burrow"},
    {"kind": "wait", "seconds": 0.1},
    {"kind": "command", "command": "assert tinyfarm.defeats 1"},
    {"kind": "command", "command": "assert tinyfarm.returned-home true"},
    {"kind": "command", "command": "walk request"},
    {"kind": "wait", "seconds": 0.1},
    {"kind": "command", "command": "assert tinyfarm.supper requested"},
    {"kind": "command", "command": "assert tinyfarm.journal SUPPER WITH MARA"},
    {"kind": "command", "command": "walk riverside"},
    {"kind": "wait", "seconds": 0.1},
    {"kind": "command", "command": "assert tinyfarm.scene riverside"},
    {"kind": "command", "command": "walk gather"},
    {"kind": "command", "command": "walk cook"},
    {"kind": "wait", "seconds": 0.1},
    {"kind": "command", "command": "save slot-1"},
    {"kind": "command", "command": "mark ready"},
    {"kind": "command", "command": "load slot-1"},
    {"kind": "command", "command": "assert-mark ready"},
    {"kind": "command", "command": "walk mara"},
    {"kind": "command", "command": "assert tinyfarm.dialogue true"},
    {"kind": "click", "x": 0.5, "y": 0.5},
    {"kind": "wait", "seconds": 0.1},
    {"kind": "tap", "keys": ["Enter"], "seconds": 0},
    {"kind": "wait", "seconds": 0.1},
    {"kind": "command", "command": "walk finish"},
    {"kind": "wait", "seconds": 0.1},
    {"kind": "command", "command": "assert tinyfarm.supper complete"},
    {"kind": "command", "command": "assert tinyfarm.dialogue false"}
  ]
}
