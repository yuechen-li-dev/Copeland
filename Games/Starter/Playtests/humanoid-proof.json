{
  "schemaVersion": 1,
  "steps": [
    { "kind": "click-action", "text": "start" },
    { "kind": "wait", "seconds": 0.05 },
    { "kind": "command", "command": "assert motion Idle" },
    { "kind": "tap", "keys": ["V"], "seconds": 0 },
    { "kind": "capture", "path": "third-person-idle.png" },
    { "kind": "hold", "keys": ["W"], "seconds": 0.10 },
    { "kind": "command", "command": "assert motion Walk" },
    { "kind": "capture", "path": "third-person-walk.png" },
    { "kind": "checkpoint", "text": "walking" },
    { "kind": "command", "command": "mark blend" },
    { "kind": "command", "command": "save humanoid-blend" },
    { "kind": "mouse-hold", "text": "Primary", "seconds": 0.15 },
    { "kind": "command", "command": "assert motion Aim" },
    { "kind": "capture", "path": "third-person-aim.png" },
    { "kind": "command", "command": "load humanoid-blend" },
    { "kind": "command", "command": "assert-mark blend" },
    { "kind": "capture", "path": "restored-blend.png" },
    { "kind": "tap", "keys": ["Escape"], "seconds": 0 },
    { "kind": "command", "command": "mark paused" },
    { "kind": "wait", "seconds": 0.10 },
    { "kind": "command", "command": "assert-mark paused" },
    { "kind": "click-action", "text": "resume" },
    { "kind": "rewind", "text": "walking" },
    { "kind": "command", "command": "assert-mark blend" },
    { "kind": "capture", "path": "replayed-blend.png" },
    { "kind": "hold", "keys": ["W", "LeftShift"], "seconds": 3 },
    { "kind": "wait", "seconds": 0.05 },
    { "kind": "command", "command": "assert motion Idle" },
    { "kind": "capture", "path": "blocked.png" },
    { "kind": "hold", "keys": ["Space"], "seconds": 0.1 },
    { "kind": "capture", "path": "airborne.png" },
    { "kind": "wait", "seconds": 1 },
    { "kind": "tap", "keys": ["V"], "seconds": 0 },
    { "kind": "command", "command": "assert view FirstPerson" },
    { "kind": "capture", "path": "first-person.png" }
  ]
}
