{
  "schemaVersion": 1,
  "steps": [
    { "kind": "command", "command": "assert screen title" },
    { "kind": "click-action", "text": "start" },
    { "kind": "command", "command": "assert view FirstPerson" },
    { "kind": "capture", "path": "first-person.png" },
    { "kind": "mouse-hold", "text": "Primary", "seconds": 0.6 },
    { "kind": "command", "command": "assert hits 4" },
    { "kind": "tap", "keys": ["R"], "seconds": 0.05 },
    { "kind": "wait", "seconds": 1.2 },
    { "kind": "command", "command": "assert ammo 12" },
    { "kind": "tap", "keys": ["V"], "seconds": 0 },
    { "kind": "command", "command": "assert view ThirdPerson" },
    { "kind": "capture", "path": "third-person.png" },
    { "kind": "hold", "keys": ["W"], "seconds": 0.3 },
    { "kind": "mouse-delta", "x": 80, "y": 20 },
    { "kind": "checkpoint", "text": "walked" },
    { "kind": "command", "command": "mark saved" },
    { "kind": "command", "command": "save proof-slot" },
    { "kind": "hold", "keys": ["D"], "seconds": 0.2 },
    { "kind": "command", "command": "load proof-slot" },
    { "kind": "command", "command": "assert-mark saved" },
    { "kind": "tap", "keys": ["Escape"], "seconds": 0 },
    { "kind": "click-action", "text": "settings" },
    { "kind": "capture", "path": "settings.png" },
    { "kind": "click-action", "text": "controls" },
    { "kind": "click-action", "text": "controls.sensitivity" },
    { "kind": "command", "command": "assert controls.sensitivity 3.13" },
    { "kind": "capture", "path": "controls.png" },
    { "kind": "click-action", "text": "back" },
    { "kind": "click-action", "text": "audio" },
    { "kind": "command", "command": "adjust audio.master -1" },
    { "kind": "command", "command": "assert audio.master 0.9" },
    { "kind": "capture", "path": "audio.png" },
    { "kind": "click-action", "text": "back" },
    { "kind": "click-action", "text": "back" },
    { "kind": "capture", "path": "pause.png" },
    { "kind": "click-action", "text": "resume" },
    { "kind": "rewind", "text": "walked" },
    { "kind": "command", "command": "assert-mark saved" },
    { "kind": "capture", "path": "restored.png" }
  ]
}
