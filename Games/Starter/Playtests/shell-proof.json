{
  "schemaVersion": 1,
  "steps": [
    { "kind": "command", "command": "assert screen title" },
    { "kind": "command", "command": "assert display.resolution 960x600" },
    { "kind": "capture", "path": "01-title-960x600.png" },
    { "kind": "click-action", "text": "settings" },
    { "kind": "click-action", "text": "display" },
    { "kind": "command", "command": "adjust display.resolution 1" },
    { "kind": "command", "command": "assert screen display" },
    { "kind": "capture", "path": "02-display-pending.png" },
    { "kind": "click-action", "text": "display.apply" },
    { "kind": "command", "command": "assert display.resolution 1280x720" },
    { "kind": "capture", "path": "03-display-1280x720.png" },
    { "kind": "command", "command": "adjust display.mode 1" },
    { "kind": "click-action", "text": "display.apply" },
    { "kind": "command", "command": "assert display.mode Borderless" },
    { "kind": "capture", "path": "04-borderless.png" },
    { "kind": "command", "command": "adjust display.mode 1" },
    { "kind": "click-action", "text": "display.apply" },
    { "kind": "command", "command": "assert display.mode Fullscreen" },
    { "kind": "capture", "path": "05-fullscreen-1280x720.png" },
    { "kind": "command", "command": "adjust display.mode 1" },
    { "kind": "command", "command": "adjust display.quality -1" },
    { "kind": "click-action", "text": "display.apply" },
    { "kind": "command", "command": "assert display.mode Windowed" },
    { "kind": "command", "command": "assert display.quality Medium" },
    { "kind": "click-action", "text": "back" },
    { "kind": "click-action", "text": "controls" },
    { "kind": "click-action", "text": "bindings" },
    { "kind": "capture", "path": "06-bindings.png" },
    { "kind": "click-action", "text": "bind.jump" },
    { "kind": "command", "command": "assert screen rebind" },
    { "kind": "capture", "path": "07-press-a-key.png" },
    { "kind": "tap", "keys": ["J"], "seconds": 0.05 },
    { "kind": "wait", "seconds": 0.05 },
    { "kind": "command", "command": "assert screen bindings" },
    { "kind": "command", "command": "assert binding.jump J" },
    { "kind": "click-action", "text": "bind.move.forward" },
    { "kind": "tap", "keys": ["Escape"], "seconds": 0.05 },
    { "kind": "wait", "seconds": 0.05 },
    { "kind": "command", "command": "assert binding.move.forward W" },
    { "kind": "capture", "path": "08-bindings-after.png" },
    { "kind": "tap", "keys": ["Escape"], "seconds": 0 },
    { "kind": "tap", "keys": ["Escape"], "seconds": 0 },
    { "kind": "tap", "keys": ["Escape"], "seconds": 0 },
    { "kind": "command", "command": "assert screen title" },
    { "kind": "click-action", "text": "start" },
    { "kind": "command", "command": "assert screen playing" },
    { "kind": "resize", "width": 1600, "height": 900 },
    { "kind": "wait", "seconds": 0.1 },
    { "kind": "capture", "path": "09-playing-1600x900.png" },
    { "kind": "tap", "keys": ["Escape"], "seconds": 0 },
    { "kind": "command", "command": "assert screen pause" },
    { "kind": "capture", "path": "10-pause-1600x900.png" },
    { "kind": "focus", "focused": false },
    { "kind": "focus", "focused": true },
    { "kind": "command", "command": "assert screen pause" },
    { "kind": "click-action", "text": "resume" },
    { "kind": "command", "command": "assert screen playing" }
  ]
}
