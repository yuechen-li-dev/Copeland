{
  "schemaVersion": 1,
  "steps": [
    { "kind": "click-action", "text": "start" },
    { "kind": "tap", "keys": ["V"], "seconds": 0 },
    { "kind": "wait", "seconds": 0.2 },
    { "kind": "hold", "keys": ["W"], "seconds": 0.5 },
    { "kind": "command", "command": "assert gait Walk" },
    { "kind": "capture", "path": "walking.png" },
    { "kind": "hold", "keys": ["W", "LeftShift"], "seconds": 0.05 },
    { "kind": "command", "command": "assert gait Run" },
    { "kind": "command", "command": "assert motion Run" },
    { "kind": "command", "command": "mark run-blend" },
    { "kind": "checkpoint", "text": "running" },
    { "kind": "command", "command": "save run-blend" },
    { "kind": "capture", "path": "run-blend.png" },
    { "kind": "press", "keys": ["W", "LeftShift"] },
    { "kind": "mouse-hold", "text": "Primary", "seconds": 0.2 },
    { "kind": "command", "command": "assert gait Run" },
    { "kind": "command", "command": "assert motion Aim" },
    { "kind": "capture", "path": "running-aim.png" },
    { "kind": "release", "keys": ["W", "LeftShift"] },
    { "kind": "wait", "seconds": 0.2 },
    { "kind": "command", "command": "load run-blend" },
    { "kind": "command", "command": "assert-mark run-blend" },
    { "kind": "capture", "path": "restored-run.png" },
    { "kind": "rewind", "text": "running" },
    { "kind": "command", "command": "assert-mark run-blend" },
    { "kind": "capture", "path": "replayed-run.png" },
    { "kind": "hold", "keys": ["W", "LeftShift"], "seconds": 3 },
    { "kind": "wait", "seconds": 0.3 },
    { "kind": "command", "command": "assert gait Idle" },
    { "kind": "capture", "path": "blocked-idle.png" },
    { "kind": "hold", "keys": ["Space"], "seconds": 0.1 },
    { "kind": "capture", "path": "jump-released.png" },
    { "kind": "wait", "seconds": 1 },
    { "kind": "tap", "keys": ["V"], "seconds": 0 },
    { "kind": "command", "command": "assert view FirstPerson" },
    { "kind": "capture", "path": "first-person.png" }
  ]
}
