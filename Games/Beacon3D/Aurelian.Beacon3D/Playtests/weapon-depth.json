{
  "schemaVersion": 1,
  "steps": [
    { "kind": "wait", "seconds": 2 },
    { "kind": "command", "command": "inspect rendering" },
    { "kind": "click-action", "text": "start" },
    { "kind": "hold", "keys": ["d"], "seconds": 0.25 },
    { "kind": "hold", "keys": ["w"], "seconds": 1.5 },
    { "kind": "command", "command": "assert presentation.obstruction 1" },
    { "kind": "capture", "path": "wall.png" },
    { "kind": "command", "command": "mark wall" },
    { "kind": "checkpoint", "text": "wall" },
    { "kind": "mouse-press", "text": "secondary" },
    { "kind": "wait", "seconds": 0.5 },
    { "kind": "command", "command": "assert presentation.aim 0" },
    { "kind": "mouse-hold", "text": "primary", "seconds": 0.1 },
    { "kind": "tap", "keys": ["r"], "seconds": 0.017 },
    { "kind": "wait", "seconds": 0.2 },
    { "kind": "command", "command": "assert audio.shot 1" },
    { "kind": "command", "command": "assert audio.reload 1" },
    { "kind": "capture", "path": "wall-reload.png" },
    { "kind": "tap", "keys": ["b"], "seconds": 0.017 },
    { "kind": "command", "command": "assert presentation.obstruction 1" },
    { "kind": "capture", "path": "wall-motion-disabled.png" },
    { "kind": "rewind", "text": "wall" },
    { "kind": "command", "command": "assert-mark wall" },
    { "kind": "hold", "keys": ["s"], "seconds": 0.5 },
    { "kind": "wait", "seconds": 0.3 },
    { "kind": "capture", "path": "clearance-restored.png" },
    { "kind": "tap", "keys": ["escape"], "seconds": 0.017 },
    { "kind": "click-action", "text": "settings" },
    { "kind": "click-action", "text": "display" },
    { "kind": "command", "command": "assert display.adaptive true" },
    { "kind": "capture", "path": "adaptive-setting.png" },
    { "kind": "command", "command": "adjust display.adaptive -1" },
    { "kind": "command", "command": "assert display.adaptive true" },
    { "kind": "click-action", "text": "display.apply" },
    { "kind": "command", "command": "assert display.adaptive false" },
    { "kind": "command", "command": "inspect rendering" },
    { "kind": "resize", "width": 1000, "height": 650 },
    { "kind": "command", "command": "inspect rendering" },
    { "kind": "capture", "path": "fixed-quality-resized.png" },
    { "kind": "command", "command": "adjust display.adaptive 1" },
    { "kind": "click-action", "text": "display.apply" },
    { "kind": "click-action", "text": "back" },
    { "kind": "click-action", "text": "back" },
    { "kind": "click-action", "text": "resume" },
    { "kind": "tap", "keys": ["v"], "seconds": 0.017 },
    { "kind": "command", "command": "assert presentation.viewmodel false" },
    { "kind": "capture", "path": "third-person.png" },
    { "kind": "tap", "keys": ["v"], "seconds": 0.017 },
    { "kind": "command", "command": "assert presentation.viewmodel true" },
    { "kind": "capture", "path": "first-person-restored.png" }
  ]
}
