{
  "schemaVersion": 1,
  "steps": [
    { "kind": "click-action", "text": "start" },
    { "kind": "wait", "seconds": 0.5 },
    { "kind": "capture", "path": "covered-spawn.png" },
    { "kind": "hold", "keys": ["w"], "seconds": 1 },
    { "kind": "hold", "keys": ["a"], "seconds": 1.2 },
    { "kind": "wait", "seconds": 0.3 },
    { "kind": "mouse-delta", "x": 0, "y": 200 },
    { "kind": "wait", "seconds": 0.017 },
    { "kind": "capture", "path": "puddle-steps.png" },
    { "kind": "mouse-delta", "x": 0, "y": -200 },
    { "kind": "wait", "seconds": 0.017 },
    { "kind": "command", "command": "mark puddle" },
    { "kind": "checkpoint", "text": "puddle" },
    { "kind": "mouse-press", "text": "secondary" },
    { "kind": "wait", "seconds": 0.5 },
    { "kind": "capture", "path": "aim.png" },
    { "kind": "mouse-hold", "text": "primary", "seconds": 0.1 },
    { "kind": "command", "command": "assert audio.shot 1" },
    { "kind": "capture", "path": "recoil.png" },
    { "kind": "tap", "keys": ["r"], "seconds": 0.017 },
    { "kind": "wait", "seconds": 0.25 },
    { "kind": "command", "command": "assert audio.reload 1" },
    { "kind": "capture", "path": "reload.png" },
    { "kind": "rewind", "text": "puddle" },
    { "kind": "command", "command": "assert-mark puddle" },
    { "kind": "hold", "keys": ["space"], "seconds": 1 },
    { "kind": "command", "command": "assert presentation.landings 1" },
    { "kind": "command", "command": "assert audio.land 1" },
    { "kind": "hold", "keys": ["w", "leftshift"], "seconds": 0.3 },
    { "kind": "capture", "path": "sprint.png" },
    { "kind": "tap", "keys": ["b"], "seconds": 0.017 },
    { "kind": "command", "command": "assert presentation.enabled false" },
    { "kind": "capture", "path": "motion-disabled.png" },
    { "kind": "command", "command": "presentation on" },
    { "kind": "focus", "focused": false },
    { "kind": "command", "command": "mark paused" },
    { "kind": "wait", "seconds": 0.3 },
    { "kind": "command", "command": "assert-mark paused" },
    { "kind": "focus", "focused": true },
    { "kind": "click-action", "text": "resume" },
    { "kind": "resize", "width": 1000, "height": 650 },
    { "kind": "capture", "path": "resized.png" },
    { "kind": "tap", "keys": ["escape"], "seconds": 0.017 },
    { "kind": "click-action", "text": "title" },
    { "kind": "click-action", "text": "start" },
    { "kind": "command", "command": "assert audio.shot 0" },
    { "kind": "command", "command": "assert presentation.steps 0" },
    { "kind": "capture", "path": "restart.png" }
  ]
}
