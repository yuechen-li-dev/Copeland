{
  "schemaVersion": 1,
  "steps": [
    {"kind": "command", "command": "assert screen title"},
    {"kind": "click-action", "text": "start"},
    {"kind": "wait", "seconds": 2},
    {"kind": "command", "command": "assert wave 1"},
    {"kind": "press", "keys": ["w"]},
    {"kind": "command", "command": "mark origin"},
    {"kind": "checkpoint", "text": "origin"},
    {"kind": "mouse-delta", "x": 80, "y": -20},
    {"kind": "mouse-hold", "text": "primary", "seconds": 0.3},
    {"kind": "wait", "seconds": 0.2},
    {"kind": "rewind", "text": "origin"},
    {"kind": "command", "command": "assert-mark origin"},
    {"kind": "mouse-delta", "x": 80, "y": -20},
    {"kind": "mouse-hold", "text": "primary", "seconds": 0.3},
    {"kind": "wait", "seconds": 0.2},
    {"kind": "release", "keys": ["w"]},
    {"kind": "command", "command": "inspect brains"},
    {"kind": "command", "command": "mark paused"},
    {"kind": "tap", "keys": ["escape"]},
    {"kind": "wait", "seconds": 0.5},
    {"kind": "click-action", "text": "resume"},
    {"kind": "command", "command": "assert-mark paused"}
  ]
}
