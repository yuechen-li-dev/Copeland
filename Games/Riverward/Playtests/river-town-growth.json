{
  "schemaVersion": 1,
  "steps": [
    { "kind": "click-action", "text": "start" },
    { "kind": "click-action", "text": "tool-park" },
    { "kind": "wait", "seconds": 0.07 },
    { "kind": "click-action", "text": "hex:-1:0" },
    { "kind": "wait", "seconds": 0.07 },
    { "kind": "click-action", "text": "tool-streets" },
    { "kind": "wait", "seconds": 0.07 },
    { "kind": "click-action", "text": "hex:1:0:1" },
    { "kind": "wait", "seconds": 0.07 },
    { "kind": "click-action", "text": "hex:1:0:0" },
    { "kind": "wait", "seconds": 0.07 },
    { "kind": "click-action", "text": "hex:-2:0:0" },
    { "kind": "wait", "seconds": 0.07 },
    { "kind": "click-action", "text": "hex:-2:0:1" },
    { "kind": "wait", "seconds": 0.07 },
    { "kind": "click-action", "text": "tool-market" },
    { "kind": "wait", "seconds": 0.07 },
    { "kind": "click-action", "text": "hex:-3:1" },
    { "kind": "wait", "seconds": 0.07 },
    { "kind": "command", "command": "assert hex.-3.1.customers 10" },
    { "kind": "click-action", "text": "tool-workshop" },
    { "kind": "wait", "seconds": 0.07 },
    { "kind": "click-action", "text": "hex:1:1" },
    { "kind": "wait", "seconds": 0.07 },
    { "kind": "command", "command": "assert city.jobs 28" },
    { "kind": "tap", "keys": ["Space", "F"], "seconds": 0.07 },
    { "kind": "wait", "seconds": 20 },
    { "kind": "tap", "keys": ["Space"], "seconds": 0.07 },
    { "kind": "command", "command": "assert city.won true" },
    { "kind": "command", "command": "assert city.employed 28" },
    { "kind": "command", "command": "assert city.balance 113" },
    { "kind": "command", "command": "assert hex.-2.0.residents 14" },
    { "kind": "command", "command": "assert hex.-2.1.residents 14" },
    { "kind": "command", "command": "save slot-1" },
    { "kind": "command", "command": "load slot-1" },
    { "kind": "command", "command": "assert city.won true" }
  ]
}
