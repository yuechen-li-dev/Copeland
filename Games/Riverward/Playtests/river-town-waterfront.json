{
  "schemaVersion": 1,
  "steps": [
    { "kind": "click-action", "text": "start" },
    { "kind": "resize", "width": 1280, "height": 800 },
    { "kind": "click-action", "text": "tool-streets" },
    { "kind": "wait", "seconds": 0.07 },
    { "kind": "click-action", "text": "hex:1:-3:5" },
    { "kind": "wait", "seconds": 0.07 },
    { "kind": "click-action", "text": "tool-workshop" },
    { "kind": "wait", "seconds": 0.07 },
    { "kind": "click-action", "text": "hex:2:-3" },
    { "kind": "wait", "seconds": 0.07 },
    { "kind": "click-action", "text": "tool-fishmarket" },
    { "kind": "wait", "seconds": 0.07 },
    { "kind": "click-action", "text": "hex:1:-2" },
    { "kind": "wait", "seconds": 0.07 },
    { "kind": "command", "command": "assert hex.1.-2.net -18" },
    { "kind": "click-action", "text": "tool-boardwalk" },
    { "kind": "wait", "seconds": 0.07 },
    { "kind": "click-action", "text": "hex:-1:1" },
    { "kind": "wait", "seconds": 0.07 },
    { "kind": "command", "command": "assert city.housing 24" },
    { "kind": "click-action", "text": "tool-dock" },
    { "kind": "wait", "seconds": 0.07 },
    { "kind": "click-action", "text": "hex:-1:0" },
    { "kind": "wait", "seconds": 0.07 },
    { "kind": "command", "command": "assert city.ferry.stops 0" },
    { "kind": "command", "command": "assert city.jobs 14" },
    { "kind": "pointer", "x": 0.452, "y": 0.319 },
    { "kind": "wait", "seconds": 0.07 },
    { "kind": "command", "command": "assert hover 1,-3" },
    { "kind": "command", "command": "assert preview.ferry.stops 2" },
    { "kind": "command", "command": "assert preview.ferry.trips 10" },
    { "kind": "capture", "path": "ferry-preview.png" },
    { "kind": "click-action", "text": "hex:1:-3" },
    { "kind": "wait", "seconds": 0.07 },
    { "kind": "command", "command": "assert city.jobs 28" },
    { "kind": "command", "command": "assert city.happiness 82" },
    { "kind": "command", "command": "assert hex.1.-2.net 52" },
    { "kind": "command", "command": "inspect rendering" },
    { "kind": "tap", "keys": ["Space", "F"], "seconds": 0.07 },
    { "kind": "wait", "seconds": 0.95 },
    { "kind": "tap", "keys": ["Space"], "seconds": 0.07 },
    { "kind": "click-action", "text": "tool-inspect" },
    { "kind": "wait", "seconds": 0.07 },
    { "kind": "click-action", "text": "hex:1:-2" },
    { "kind": "wait", "seconds": 0.07 },
    { "kind": "capture", "path": "river-commerce.png" },
    { "kind": "command", "command": "save slot-1" },
    { "kind": "command", "command": "load slot-1" },
    { "kind": "command", "command": "assert city.ferry.stops 2" },
    { "kind": "command", "command": "assert hex.1.-2.net 52" },
    { "kind": "tap", "keys": ["Space", "F"], "seconds": 0.07 },
    { "kind": "wait", "seconds": 24 },
    { "kind": "tap", "keys": ["Space"], "seconds": 0.07 },
    { "kind": "command", "command": "assert city.won true" },
    { "kind": "command", "command": "assert city.employed 24" },
    { "kind": "command", "command": "assert city.happiness 85" },
    { "kind": "command", "command": "assert city.balance 111" },
    { "kind": "command", "command": "assert city.ferry.trips 12" },
    { "kind": "capture", "path": "prosperous-waterfront.png" }
  ]
}
