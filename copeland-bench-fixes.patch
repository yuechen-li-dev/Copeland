+                return true;
+            }
+
+            Report(
+                "COPE-CALL-0021",
+                $"'{member.NameToken.Text}' is not a method of '{receiverName.IdentifierToken.Text}' of type '{receiverType.Name}'. Copeland values have no receiver methods; pass the value to a function or a CLR static API instead.",
+                member.NameToken);
+            return true;
+        }
