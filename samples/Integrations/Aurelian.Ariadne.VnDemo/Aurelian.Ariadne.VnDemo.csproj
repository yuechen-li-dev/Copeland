    <ProjectReference Include="../../../src/Aurelian/Aurelian.Audio/Aurelian.Audio.csproj" />
    <ProjectReference Include="../../../src/Aurelian/Aurelian.Graphics/Aurelian.Graphics.csproj" />
    <ProjectReference Include="../../../src/Aurelian/Aurelian.Rendering.Raster/Aurelian.Rendering.Raster.csproj" />
