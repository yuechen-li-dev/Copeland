{
  "artifactDirectory": "../artifacts/cts-website-table-layout-m0",
  "scenarios": [
    {
      "name": "desktop",
      "viewport": { "width": 1440, "height": 900 },
      "assertions": [
        { "kind": "count", "selector": "[data-machina-layout='CopelandDesktop'][data-machina-box='root']", "value": 1 },
        { "kind": "visible", "selector": ".command-bar" },
        { "kind": "visible", "selector": "[data-machina-layout='CopelandDesktop'][data-machina-box='hero'] .hero-title .text-fit-target" },
        { "kind": "count", "selector": ".feature-card", "value": 4 },
        { "kind": "no-horizontal-overflow" }
      ],
      "steps": [
        { "kind": "press", "key": "Tab" },
        { "kind": "check", "check": { "kind": "focused", "selector": ".command-bar .brand" } },
        { "kind": "click", "selector": ".command-actions button" }
      ],
      "screenshot": "desktop-1440x900.png"
    },
    {
      "name": "tablet",
      "viewport": { "width": 768, "height": 1024 },
      "assertions": [
        { "kind": "count", "selector": "[data-machina-layout='CopelandTablet'][data-machina-box='root']", "value": 1 },
        { "kind": "visible", "selector": ".compact-command-bar" },
        { "kind": "count", "selector": ".feature-card", "value": 4 },
        { "kind": "no-horizontal-overflow" }
      ],
      "screenshot": "tablet-768x1024.png"
    },
    {
      "name": "mobile",
      "viewport": { "width": 390, "height": 844 },
      "reducedMotion": "reduce",
      "assertions": [
        { "kind": "count", "selector": "[data-machina-layout='CopelandMobile'][data-machina-box='root']", "value": 1 },
        { "kind": "visible", "selector": ".compact-command-bar" },
        { "kind": "count", "selector": ".feature-card", "value": 4 },
        { "kind": "no-horizontal-overflow" },
        { "kind": "reduced-motion" }
      ],
      "screenshot": "mobile-390x844.png"
    },
    { "name": "boundary-mobile-599", "viewport": { "width": 599, "height": 844 }, "assertions": [{ "kind": "visible", "selector": "[data-machina-layout='CopelandMobile'][data-machina-box='root']" }] },
    { "name": "boundary-tablet-600", "viewport": { "width": 600, "height": 1024 }, "assertions": [{ "kind": "visible", "selector": "[data-machina-layout='CopelandTablet'][data-machina-box='root']" }] },
    { "name": "boundary-tablet-1023", "viewport": { "width": 1023, "height": 900 }, "assertions": [{ "kind": "visible", "selector": "[data-machina-layout='CopelandTablet'][data-machina-box='root']" }] },
    { "name": "boundary-desktop-1024", "viewport": { "width": 1024, "height": 800 }, "assertions": [{ "kind": "visible", "selector": "[data-machina-layout='CopelandDesktop'][data-machina-box='root']" }] }
  ]
}
