    <RootNamespace>Copeland.Authoring.Food</RootNamespace>
    <AssemblyName>Copeland.Authoring.Food</AssemblyName>
    <CopelandTaskAssembly>$(MSBuildProjectDirectory)\..\..\..\src\Copeland\Copeland.TS.MSBuild\bin\$(Configuration)\net10.0\Copeland.TS.MSBuild.dll</CopelandTaskAssembly>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Copeland/Copeland.TS.MSBuild/Copeland.TS.MSBuild.csproj"
