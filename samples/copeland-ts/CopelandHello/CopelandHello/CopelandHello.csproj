<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CopelandHello</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <CopelandRequiredVersion>0.1.0-preview.1</CopelandRequiredVersion>
    <CopelandNpmLockFile>package-lock.json</CopelandNpmLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Copeland.TS.Sdk"
                      Version="0.1.0-preview.1"
                      PrivateAssets="all" />
    <CopelandNpmContract Include="contracts/lodash-es.json" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
</Project>
