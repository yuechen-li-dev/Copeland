<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <!-- Preview 1 distribution train. All coordinated artifacts use this authority. -->
    <CopelandToolchainVersion>0.1.0-preview.1</CopelandToolchainVersion>
    <Version Condition="'$(Version)' == ''">$(CopelandToolchainVersion)</Version>
    <PackageVersion Condition="'$(PackageVersion)' == ''">$(CopelandToolchainVersion)</PackageVersion>
  </PropertyGroup>
</Project>
