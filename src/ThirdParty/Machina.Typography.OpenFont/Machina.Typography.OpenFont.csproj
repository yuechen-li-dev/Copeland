<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>Machina.Typography.OpenFont</AssemblyName>
    <RootNamespace>Typography.OpenFont</RootNamespace>
    <Version>1.0.0</Version>
    <PackageVersion>1.0.0</PackageVersion>
    <PackageId>Machina.Typography.OpenFont</PackageId>
    <Title>Machina Typography.OpenFont</Title>
    <Authors>LayoutFarm contributors; Machina project contributors</Authors>
    <Description>A maintained, source-built distribution of LayoutFarm Typography.OpenFont with corrected glyph identity and advance handling.</Description>
    <PackageTags>opentype;truetype;font;typography;machina</PackageTags>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/yuechen-li-dev/Copeland</PackageProjectUrl>
    <RepositoryUrl>https://github.com/yuechen-li-dev/Copeland</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Numerics.Vectors" />
  </ItemGroup>

  <ItemGroup>
    <None Include="LICENSE.md" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="UPSTREAM.md" Pack="true" PackagePath="" />
    <None Include="PATCHES.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
