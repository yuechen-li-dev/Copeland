<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Aurelian.Graphics</AssemblyName>
    <RootNamespace>Aurelian.Graphics</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Aurelian.Diagnostics/Aurelian.Diagnostics.csproj" />
    <ProjectReference Include="../Aurelian.Rendering.Contracts/Aurelian.Rendering.Contracts.csproj" />
    <EmbeddedResource Include="Vulkan/Native3D/Assets/ClearcoatDfg.bin" LogicalName="Aurelian.Graphics.ClearcoatDfg" />
    <EmbeddedResource Include="Vulkan/Native3D/Assets/AnisotropyDfg.bin" LogicalName="Aurelian.Graphics.AnisotropyDfg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Vulkan" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" />
    <PackageReference Include="Silk.NET.Windowing" />
  </ItemGroup>
</Project>
