<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Copeland.Cli</AssemblyName>
    <RootNamespace>Copeland.Cli</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tscl</ToolCommandName>
    <PackageId>Copeland.TS.Tool</PackageId>
    <PackageVersion>$(CopelandToolchainVersion)</PackageVersion>
    <Authors>Yuechen Li and Copeland contributors</Authors>
    <Description>Compile Copeland TypeScript and C# together in normal .NET 10 projects. Installs the tscl command, compiler, template tooling, and language server.</Description>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/yuechen-li-dev/Copeland</PackageProjectUrl>
    <RepositoryUrl>https://github.com/yuechen-li-dev/Copeland</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>copeland;typescript;tsx;compiler;dotnet-tool;language-server</PackageTags>
    <PackageReleaseNotes>First public preview of Copeland TS for mixed TypeScript, TSX, and C# projects on .NET 10.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <ProjectReference Include="../Copeland.Markdown/Copeland.Markdown.csproj" />
    <ProjectReference Include="../Copeland.TS/Copeland.TS.csproj" />
    <ProjectReference Include="../Copeland.TS.Database/Copeland.TS.Database.csproj" />
    <ProjectReference Include="../Copeland.TS.Mir/Copeland.TS.Mir.csproj" />
    <ProjectReference Include="../Copeland.TS.Backend.CSharp/Copeland.TS.Backend.CSharp.csproj" />
    <ProjectReference Include="../Copeland.TS.Backend.JavaScript/Copeland.TS.Backend.JavaScript.csproj" />
    <ProjectReference Include="../Copeland.TS.LanguageServer/Copeland.TS.LanguageServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
