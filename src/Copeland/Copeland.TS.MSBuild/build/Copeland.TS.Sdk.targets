<Project>
  <UsingTask TaskName="Copeland.TS.MSBuild.CopelandCompile" AssemblyFile="$(CopelandTaskAssembly)" />

  <Target Name="CopelandCompile"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveReferences"
          Condition="'@(CopelandCompile)' != ''">
    <Copeland.TS.MSBuild.CopelandCompile
        Sources="@(CopelandCompile)"
        CSharpSources="@(Compile)"
        ClrReferencePaths="@(ReferencePath);@(ReferencePathWithRefAssemblies)"
        IntermediateOutputPath="$(IntermediateOutputPath)"
        ProjectDirectory="$(MSBuildProjectDirectory)"
        AssemblyName="$(AssemblyName)"
        LangVersion="$(LangVersion)"
        DefineConstants="$(DefineConstants)"
        Nullable="$(Nullable)"
        RootNamespace="$(RootNamespace)">
      <Output TaskParameter="GeneratedSources" ItemName="CopelandGeneratedCompile" />
    </Copeland.TS.MSBuild.CopelandCompile>

    <ItemGroup>
      <Compile Include="@(CopelandGeneratedCompile)" />
      <FileWrites Include="@(CopelandGeneratedCompile)" />
    </ItemGroup>
  </Target>
</Project>
