<Project>
  <PropertyGroup>
    <CopelandGeneratedDirectory Condition="'$(CopelandGeneratedDirectory)' == ''">$(IntermediateOutputPath)Copeland\</CopelandGeneratedDirectory>
    <CopelandTestGeneratedDirectory Condition="'$(CopelandTestGeneratedDirectory)' == ''">$(BaseIntermediateOutputPath)CopelandTests\</CopelandTestGeneratedDirectory>
    <CopelandTaskAssembly Condition="'$(CopelandTaskAssembly)' == ''">$(MSBuildThisFileDirectory)..\tools\net10.0\Copeland.TS.MSBuild.dll</CopelandTaskAssembly>
    <CopelandSdkVersion Condition="'$(CopelandSdkVersion)' == ''">0.1.0-preview.1-tsxml.1</CopelandSdkVersion>
    <CopelandRequiredVersion Condition="'$(CopelandRequiredVersion)' == ''">$(CopelandSdkVersion)</CopelandRequiredVersion>
    <CopelandXunitVersion Condition="'$(CopelandXunitVersion)' == ''">2.9.3</CopelandXunitVersion>
    <CopelandTestSdkVersion Condition="'$(CopelandTestSdkVersion)' == ''">17.14.1</CopelandTestSdkVersion>
    <CopelandXunitRunnerVersion Condition="'$(CopelandXunitRunnerVersion)' == ''">3.1.5</CopelandXunitRunnerVersion>
    <CopelandSameProjectTestHost Condition="'$(CopelandSameProjectTestHost)' == ''">true</CopelandSameProjectTestHost>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Copeland.TS.Backend.CSharp"
               HintPath="$(MSBuildThisFileDirectory)..\tools\net10.0\Copeland.TS.Backend.CSharp.dll"
               Private="true" />
    <CopelandTest Include="**\*.tsxtest" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk"
                      Version="$(CopelandTestSdkVersion)"
                      PrivateAssets="all"
                      Condition="'@(CopelandTest)' != ''">
      <CopelandOwnedTestSdk>true</CopelandOwnedTestSdk>
    </PackageReference>
  </ItemGroup>
</Project>
