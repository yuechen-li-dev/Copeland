const $schema: string = "copeland://corpus/table-m0b";

record Point {
    x: number;
    label: string;
}

record table Representative {
    enabled: boolean = [
        true,
        false,
    ];
    edge: number = [
        $number("0000000000000000"),
        $number("8000000000000000"),
    ];
    text: string = [
        "quote: \"; snow: 雪; pair: 😀",
        "line\nnext",
    ];
    point: Point = [
        $record.Point({
            "x": $number("3FE0000000000000"),
            "label": "a",
        }),
        $record.Point({
            "x": $number("7FF0000000000000"),
            "label": "b",
        }),
    ];
    state: State = [
        State.Missing,
        State.Named(
            "ready"
        ),
    ];
    matrix: number[][] = [
        [
            [
                $number("3FF0000000000000"),
            ],
            [],
        ],
        [
            [
                $number("FFF0000000000000"),
            ],
            [
                $number("7FF8000000000000"),
            ],
        ],
    ];
}

enum State {
    Missing,
    Named(label: string),
}

const $value = Representative;
