const $schema: string = "copeland://corpus/runtime-array-encoding";

record Detail {
    label: string;
}

record Packet {
    emptyNumbers: number[];
    booleans: boolean[];
    numbers: number[];
    texts: string[];
    nested: number[][];
    details: Detail[];
    signals: Signal[];
    emptyDetails: Detail[];
}

enum Signal {
    Idle,
    Text(value: string),
    DetailValue(detail: Detail),
}

const $value = $record.Packet({
    "emptyNumbers": [],
    "booleans": [
        true,
        false,
        true,
    ],
    "numbers": [
        $number("0000000000000000"),
        $number("8000000000000000"),
        $number("3FF8000000000000"),
        $number("7FF8000000000000"),
        $number("7FF0000000000000"),
        $number("FFF0000000000000"),
    ],
    "texts": [
        "quote: \"; slash: \\; line: \n",
        "snow 雪 😀",
    ],
    "nested": [
        [
            $number("0000000000000000"),
            $number("8000000000000000"),
        ],
        [
            $number("3FF8000000000000"),
        ],
        [],
    ],
    "details": [
        $record.Detail({
            "label": "first",
        }),
        $record.Detail({
            "label": "second",
        }),
    ],
    "signals": [
        Signal.Idle,
        Signal.Text(
            "payload"
        ),
        Signal.DetailValue(
            $record.Detail({
                "label": "nested record",
            })
        ),
    ],
    "emptyDetails": [],
});
