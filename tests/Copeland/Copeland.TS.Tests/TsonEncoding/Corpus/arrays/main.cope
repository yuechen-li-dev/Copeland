module

enum TsonEncodeError
  case InvalidUnicode
  case OutputLimitExceeded

enum Signal
  case Idle
  case Text(value: string)
  case DetailValue(detail: Detail)

record Detail [r1]
  field label [r1.f0]: string

record Packet [r2]
  field emptyNumbers [r2.f0]: number[]
  field booleans [r2.f1]: boolean[]
  field numbers [r2.f2]: number[]
  field texts [r2.f3]: string[]
  field nested [r2.f4]: number[][]
  field details [r2.f5]: Detail[]
  field signals [r2.f6]: Signal[]
  field emptyDetails [r2.f7]: Detail[]

tson-plan tson0 schema copeland://corpus/runtime-array-encoding root Packet limits utf8=1048576 string-utf16=262144 array-length=100000
  record Detail [r1] identity copeland://corpus/runtime-array-encoding#Detail
    field label [r1.f0] identity copeland://corpus/runtime-array-encoding#Detail.label: string
  record Packet [r2] identity copeland://corpus/runtime-array-encoding#Packet
    field emptyNumbers [r2.f0] identity copeland://corpus/runtime-array-encoding#Packet.emptyNumbers: number[]
    field booleans [r2.f1] identity copeland://corpus/runtime-array-encoding#Packet.booleans: boolean[]
    field numbers [r2.f2] identity copeland://corpus/runtime-array-encoding#Packet.numbers: number[]
    field texts [r2.f3] identity copeland://corpus/runtime-array-encoding#Packet.texts: string[]
    field nested [r2.f4] identity copeland://corpus/runtime-array-encoding#Packet.nested: number[][]
    field details [r2.f5] identity copeland://corpus/runtime-array-encoding#Packet.details: record [r1][]
    field signals [r2.f6] identity copeland://corpus/runtime-array-encoding#Packet.signals: enum Signal[]
    field emptyDetails [r2.f7] identity copeland://corpus/runtime-array-encoding#Packet.emptyDetails: record [r1][]
  enum Signal identity copeland://corpus/runtime-array-encoding#Signal
    case Idle identity copeland://corpus/runtime-array-encoding#Signal.Idle
    case Text identity copeland://corpus/runtime-array-encoding#Signal.Text
      payload value identity copeland://corpus/runtime-array-encoding#Signal.Text.value: string
    case DetailValue identity copeland://corpus/runtime-array-encoding#Signal.DetailValue
      payload detail identity copeland://corpus/runtime-array-encoding#Signal.DetailValue.detail: record [r1]

func encode() -> string ! TsonEncodeError
locals:
  const loaded: Packet
entry:
  store loaded, record-new [r2] { [r2.f0]: [], [r2.f1]: [true, false, true], [r2.f2]: [0, -0, 1.5, NaN, Infinity, -Infinity], [r2.f3]: ["quote: "; slash: \; line: 
", "snow 雪 😀"], [r2.f4]: [[0, -0], [1.5], []], [r2.f5]: [record-new [r1] { [r1.f0]: "first" }, record-new [r1] { [r1.f0]: "second" }], [r2.f6]: [enum Signal.Idle, enum Signal.Text("payload"), enum Signal.DetailValue(record-new [r1] { [r1.f0]: "nested record" })], [r2.f7]: [] }
  return tson-encode [tson0] loaded : string ! TsonEncodeError
