const $schema: string = "copeland://corpus/runtime-table-encoding";

record Point {
    name: string;
}

record table Samples {
    active: boolean = [
        true,
        false,
        true,
        false,
        true,
    ];
    score: number = [
        $number("0000000000000000"),
        $number("8000000000000000"),
        $number("3FF8000000000000"),
        $number("7FF8000000000000"),
        $number("FFF0000000000000"),
    ];
    point: Point = [
        $record.Point({
            "name": "plain",
        }),
        $record.Point({
            "name": "quote \" slash \\ newline\n",
        }),
        $record.Point({
            "name": "雪",
        }),
        $record.Point({
            "name": "😀",
        }),
        $record.Point({
            "name": "𐐷",
        }),
    ];
    state: State = [
        State.Off,
        State.Named(
            "payload"
        ),
        State.Named(
            "雪"
        ),
        State.Off,
        State.Named(
            "array"
        ),
    ];
    values: number[][] = [
        [],
        [
            [
                $number("3FF0000000000000"),
                $number("4000000000000000"),
            ],
            [],
        ],
        [
            [],
            [
                $number("0000000000000000"),
            ],
        ],
        [
            [
                $number("7FF0000000000000"),
            ],
        ],
        [
            [
                $number("7FF8000000000000"),
            ],
        ],
    ];
}

enum State {
    Off,
    Named(label: string),
}

const $value = Samples;
