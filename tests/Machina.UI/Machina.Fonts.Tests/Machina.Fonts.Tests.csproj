<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Machina.Fonts.Tests</AssemblyName>
    <RootNamespace>Machina.Fonts.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin-diagnostics/**;obj-diagnostics/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Machina.UI/Machina.Fonts/Machina.Fonts.csproj" />
    <ProjectReference Include="../../../src/Machina.UI/Machina.Fonts.AvaloniaOracle/Machina.Fonts.AvaloniaOracle.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Rendering/FontProofExporterTests.cs" />
    <Compile Remove="Rendering/FontReferenceDiffWorkflowTests.cs" />
    <Compile Remove="Rendering/FontReferenceOracleWorkflowTests.cs" />
    <Compile Remove="Rendering/ThreeWayShapeDiffWorkflowTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures\\Fonts\\**\\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
