<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Machina.Fonts.Tests</AssemblyName>
    <RootNamespace>Machina.Fonts.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Machina.UI/Machina.Fonts/Machina.Fonts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Machina.Fonts.Tests/**/*.cs"
             Exclude="../Machina.Fonts.Tests/bin*/**;../Machina.Fonts.Tests/obj*/**;../Machina.Fonts.Tests/Rendering/ShapeDiffContractTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../Machina.Fonts.Tests/Fixtures/Fonts/**/*">
      <Link>Fixtures/Fonts/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
